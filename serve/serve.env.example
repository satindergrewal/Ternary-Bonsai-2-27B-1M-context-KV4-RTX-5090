# Bonsai-2 27B serve config - copy to serve.env (next to start.sh) and edit.
# start.sh reads it if present; everything has a tested default.

# Which model: 1 = abliterated PTQ1_0 (BoldingBuilds), 0 = base PQ2_0 (PrismML)
ABLIT=1

# Context window in tokens. Above 262144 requires the GGUF context patch
# (patches/patch-gguf-context.py). 1M works on a 32GB card with KV4=1.
CONTEXT=1048576

# 4-bit KV cache with mean-centering bias. Required for CONTEXT > ~262144
# on 32GB (fp16 KV at 1M is 64 GiB).
KV4=1

# DFlash2 speculative decoding. Re-measured net-negative on a 5090
# (docs/BENCH.md); forces CONTEXT <= 921600 for VRAM.
DFLASH2=0

HOST=0.0.0.0
PORT=8013

# 1 = one conversation owns the whole context (a second request during a
# long prefill gets 503). 4 = four 262K lanes.
PARALLEL=1

# Explicit model path (overrides ABLIT). Leave empty to derive from ABLIT.
MODEL=

# API alias override (empty = derived: Bonsai-2-27B-Ablit / Bonsai-2-27B)
ALIAS=

# Demo repo location (models, launcher, drafter live under it)
DEMO=$HOME/Bonsai-demo
