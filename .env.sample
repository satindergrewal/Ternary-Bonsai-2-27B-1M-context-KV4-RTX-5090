# .env.sample - Bonsai 2 27B on one RTX 5090 (32 GB). Copy to .env and edit.
# Every value can be overridden from the environment: CONTEXT=262144 ./start.sh

# Known-good serving profile (measured 2026-09-18 on this host).
ABLIT=1                             # 0 = base PQ2_0 (PrismML, 2.13 bpw, 7.2 GiB weights)
                                    # 1 = abliterated PTQ1_0 (BoldingBuilds, 1.75 bpw,
                                    # 5.9 GiB weights). Measured decode at 1M KV4: 132 t/s
                                    # prose, 30.7 GiB idle VRAM. The alias follows this knob.
CONTEXT=1048576                     # context in tokens. Above 262144 REQUIRES
                                    # patches/patch-gguf-context.py on the model file:
                                    # llama-server caps slot context at n_ctx_train (boot log
                                    # says "capping") and silently re-partitions a bigger -c
                                    # into 262K lanes otherwise. The yarn rope scale is derived
                                    # automatically (1048576 -> x4.0).
KV4=1                               # q4_0 KV cache + the mean-centering bias
                                    # (make_kv_bias.sh in the demo repo; rebuild it per model
                                    # file when you switch quants). 64 KiB/token fp16 falls to
                                    # 18 KiB/token q4: 1M KV = 17.9 GiB instead of 64. KV4=0
                                    # at CONTEXT=1048576 does not fit a 32 GB card.
DFLASH2=0                           # 0/1 speculative decoding with the ProCreations DFlash2
                                    # drafter (~2.0 GiB VRAM). Measured 2026-09-18: acceptance
                                    # 0.11-0.22 in every config tried, including the author's
                                    # own prebuilt binary, vs 0.400 on their RTX PRO 6000 -
                                    # so decode lands BELOW undrafted here (58-117 vs ~131
                                    # t/s). Forces CONTEXT<=921600. Opt-in for code-heavy
                                    # experiments only; see docs/BENCH.md for the full matrix.
PARALLEL=1                          # slots. 1 = one request owns the whole context; a second
                                    # request during a long prefill gets a 503. 4 = four 262K
                                    # lanes (which is also what an UNPATCHED GGUF at 1M turns
                                    # into, via the slot cap).
HOST=0.0.0.0
PORT=8013
# MODEL=""                          # explicit GGUF path override (beats ABLIT)
# ALIAS=""                          # API name override; default Bonsai-2-27B-Ablit / Bonsai-2-27B
DEMO=$HOME/Bonsai-demo              # PrismML Bonsai-demo repo (launcher, models/, drafter)
